# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-key-here

# Model. Gemini 3.1 Flash-Lite is the recommended default: faster than
# 2.5 Flash, controllable reasoning, free-tier eligible.
LLM_MODEL=gemini-3.1-flash-lite

# Thinking control for Gemini 3.x models: minimal | low | medium | high
# 'minimal' gives lowest latency — right for these structured tasks.
LLM_THINKING_LEVEL=minimal

# ── Data Paths ───────────────────────────────────────────────────────────────
YELP_RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
CHROMA_DIR=./data/processed/chroma

# ── App Config ───────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=INFO

# ── Persona Engine ───────────────────────────────────────────────────────────
MIN_REVIEWS_FOR_WARM_USER=5
PERSONA_SAMPLES_PER_USER=3
PERSONA_SNIPPET_LEN=220
EMBED_MODEL=all-MiniLM-L6-v2

# ── LLM Budget ───────────────────────────────────────────────────────────────
LLM_MAX_TOKENS=1000
LLM_REVIEW_TOKENS=600
LLM_RERANK_TOKENS=1500
LLM_MAX_RETRIES=2

# ── Task A / B knobs ─────────────────────────────────────────────────────────
MAX_RAG_REVIEWS=3
RAG_SNIPPET_LEN=150
TOP_K_RETRIEVE=15
TOP_K_RETURN=10
