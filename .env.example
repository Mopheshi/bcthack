# ── LLM Provider ────────────────────────────────────────────
# Set ONE provider. Comment out the others.

# OPTION 1: Google Gemini (FREE tier — recommended)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=AIza...
LLM_MODEL=gemini-2.0-flash       # free & fast; upgrade to gemini-1.5-pro if needed

# OPTION 2: Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-20250514

# OPTION 3: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ── Data Paths ──────────────────────────────────────────────
YELP_RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
CHROMA_DIR=./data/processed/chroma

# ── App Config ──────────────────────────────────────────────
TASK_A_PORT=8001
TASK_B_PORT=8002
LOG_LEVEL=INFO

# ── Persona Engine ──────────────────────────────────────────
MIN_REVIEWS_FOR_WARM_USER=5
TOP_K_REVIEWS=20
EMBED_MODEL=all-MiniLM-L6-v2

# ── LLM Budget ──────────────────────────────────────────────
LLM_MAX_TOKENS=1000
